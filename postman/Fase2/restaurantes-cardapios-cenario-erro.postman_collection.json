          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/user/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "user",
                ""
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Cadastrar dono {{runId}}\",\n  \"email\": \"ownerLogin.{{runId}}@example.com\",\n  \"login\": \"{{ownerLogin}}\",\n  \"password\": \"{{demoPassword}}\",\n  \"userLevel\": \"OWNER\",\n  \"address\": {\n    \"address\": \"Rua A\",\n    \"number\": \"10\",\n    \"complement\": \"Casa\",\n    \"zipCode\": \"01000-000\",\n    \"neighborhood\": \"Centro\",\n    \"city\": \"São Paulo\",\n    \"state\": \"SP\",\n    \"country\": \"Brasil\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const run = Date.now().toString() + \"-\" + Math.random().toString(36).slice(2, 8);",
                  "pm.collectionVariables.set(\"runId\", run);",
                  "pm.collectionVariables.set(\"ownerLogin\", \"qa.rest.erro.\" + run);",
                  "pm.collectionVariables.set(\"otherOwnerLogin\", \"qa.rest.outro.erro.\" + run);",
                  "pm.collectionVariables.set(\"customerLogin\", \"qa.rest.cliente.erro.\" + run);",
                  "[\"ownerId\", \"categoryId\", \"restaurantId\", \"itemId\", \"otherOwnerId\", \"customerId\"].forEach(function (key) { pm.collectionVariables.set(key, \"\"); });"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
                  "if (pm.response.code === 201) pm.collectionVariables.set(\"ownerId\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
